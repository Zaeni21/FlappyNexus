PORT=8787
PRIVY_APP_ID=cmmnuhuc601up0dlbr16yfolt
PRIVY_APP_SECRET=your_privy_app_secret_here
# Optional override if Privy changes endpoint in the future.
PRIVY_VERIFY_URL=https://auth.privy.io/api/v1/sessions/verify

# Verification mode: privy-api | jwt-jwks | jwt-key
PRIVY_VERIFY_MODE=jwt-jwks

# Used when PRIVY_VERIFY_MODE=jwt-jwks (default points to your app's JWKS URL).
PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/cmmnuhuc601up0dlbr16yfolt/jwks.json

# Used when PRIVY_VERIFY_MODE=jwt-key.
# Paste from Privy dashboard (-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----)
# Keep line breaks, or use \n escapes.
PRIVY_VERIFICATION_KEY=
